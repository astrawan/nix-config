// Set the overview wallpaper on the backdrop.
layer-rule {
  match namespace="^noctalia-wallpaper*"
  place-within-backdrop true
}

/* Noctalia: blur everywhere without xray for a better look */
layer-rule {
  // run `niri msg layers` to view available layers
  match namespace="^noctalia-(bar-[^\"]+|osd|notification|panel)$"
  // https://niri-wm.github.io/niri/Configuration%3A-Layer-Rules.html#background-effect
  background-effect {
    blur true
    xray false
    noise 0.05
    saturation 2.6
  }
}

